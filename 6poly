#include <stdio.h>

struct Polynomial {
    int coeff;
    int exp;
};

int main() {
    struct Polynomial p1[10], p2[10], result[20];
    int n1, n2, i, j, k = 0;

    printf("Enter number of terms in first polynomial: ");
    scanf("%d", &n1);

    printf("\nEnter coefficient and exponent:\n");
    for (i = 0; i < n1; i++) {
        printf("Term %d: ", i + 1);
        scanf("%d %d", &p1[i].coeff, &p1[i].exp);
    }

    printf("\nEnter number of terms in second polynomial: ");
    scanf("%d", &n2);

    printf("\nEnter coefficient and exponent:\n");
    for (i = 0; i < n2; i++) {
        printf("Term %d: ", i + 1);
        scanf("%d %d", &p2[i].coeff, &p2[i].exp);
    }

    i = 0;
    j = 0;

    while (i < n1 && j < n2) {

        if (p1[i].exp == p2[j].exp) {
            result[k].coeff = p1[i].coeff + p2[j].coeff;
            result[k].exp = p1[i].exp;
            i++;
            j++;
            k++;
        }

        else if (p1[i].exp > p2[j].exp) {
            result[k] = p1[i];
            i++;
            k++;
        }

        else {
            result[k] = p2[j];
            j++;
            k++;
        }
    }

    while (i < n1) {
        result[k] = p1[i];
        i++;
        k++;
    }

    while (j < n2) {
        result[k] = p2[j];
        j++;
        k++;
    }

    printf("\nFirst Polynomial: ");
    for (i = 0; i < n1; i++) {
        printf("%dx^%d", p1[i].coeff, p1[i].exp);
        if (i != n1 - 1)
            printf(" + ");
    }

    printf("\nSecond Polynomial: ");
    for (i = 0; i < n2; i++) {
        printf("%dx^%d", p2[i].coeff, p2[i].exp);
        if (i != n2 - 1)
            printf(" + ");
    }

    printf("\n\nResultant Polynomial: ");
    for (i = 0; i < k; i++) {
        printf("%dx^%d", result[i].coeff, result[i].exp);
        if (i != k - 1)
            printf(" + ");
    }

    return 0;
}
