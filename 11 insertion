#include <stdio.h>

int main() {
    int arr[100], n;
    int i, j, key;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter the elements:\n");

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("\nOriginal Array: ");

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    for (i = 1; i < n; i++) {

        key = arr[i];
        j = i - 1;

        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = key;

        printf("\nAfter Pass %d: ", i);

        for (j = 0; j < n; j++) {
            printf("%d ", arr[j]);
        }
    }

    printf("\n\nSorted Array: ");

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
