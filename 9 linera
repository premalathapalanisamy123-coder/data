#include <stdio.h>

int main() {
    int arr[100];
    int n, search, i;
    int found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &search);

    printf("\nSearching process:\n");

    for (i = 0; i < n; i++) {

        printf("Checking element %d at position %d\n",
               arr[i], i + 1);

        if (arr[i] == search) {
            found = 1;

            printf("\nElement %d found at position %d\n",
                   search, i + 1);

            break;
        }
    }

    if (found == 0) {
        printf("\nElement %d not found in the array.\n", search);
    }

    return 0;
}
